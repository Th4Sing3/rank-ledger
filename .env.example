APP_NAME="Rank Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rank_ledger
DB_USERNAME=rank_ledger
DB_PASSWORD=rank_ledger

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

API_RATE_LIMIT_PER_MINUTE=120
LEADERBOARD_CACHE_TTL_SECONDS=15
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# These values are intentionally local-demo credentials. Replace them outside local development.
DEMO_API_KEY=local-demo-key-change-me
DEMO_WEBHOOK_URL=http://webhook-receiver:8081/webhooks/leaderboard-events
DEMO_WEBHOOK_SECRET=local-development-webhook-secret
