# Keep the build context small and make the image's dependency tree authoritative.
.git
.github
.env
.env.*
!.env.example
.tools
vendor
node_modules
npm-debug.log*
yarn-error.log*

# Local/editor state never belongs in a container image.
.idea
.vscode
.zed
.fleet
.DS_Store
Thumbs.db

# Runtime and test artefacts are recreated by the application.
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/views
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache

# The API image does not need portfolio material or the standalone receiver.
docs
examples
